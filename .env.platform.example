# Local-only settings. Never put production secrets in source control.
DATABASE_URL=postgres://pw:pw_local_only@127.0.0.1:5433/pw_control
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
NODE_ENV=development
# operator bootstrap: manually promote a user by SQL after verifying identity
# psql "$DATABASE_URL" -c "UPDATE users SET role='admin' WHERE email='your-email@example.com';"
# operations worker: omit credentials to leave preview dispatch pending configuration
GITHUB_REPOSITORY=brasalabs6/pw-web
GITHUB_TOKEN=
# Secrets never go to client apps.
AGENT_SHARED_TOKEN=
GATEWAY_CONTROL_TOKEN=

# For independent hosted SPAs, use shared-site HTTPS/proxied API and strictly listed origins.
VITE_API_BASE_URL=
VITE_PORTAL_URL=http://localhost:5174
VITE_SHELL_URL=http://localhost:5173
