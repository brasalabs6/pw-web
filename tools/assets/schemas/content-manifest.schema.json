{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pw-content-manifest-v1",
  "oneOf": [
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/catalog" },
    { "$ref": "#/$defs/bundle" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["objectSha256", "objectBytes", "offset", "bytes"],
      "properties": {
        "objectSha256": { "$ref": "#/$defs/sha256" },
        "objectBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "requiredForEntry", "spans"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "requiredForEntry": { "type": "boolean" },
        "spans": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/span" } }
      }
    },
    "index": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "sourceClient", "cookerVersion", "catalogs"],
      "properties": {
        "schema": { "const": 1 },
        "sourceClient": { "const": "1.5.3" },
        "cookerVersion": { "type": "string", "minLength": 1 },
        "catalogs": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["prefix", "sha256"],
            "properties": {
              "prefix": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "prefix", "bundles"],
      "properties": {
        "schema": { "const": 1 },
        "prefix": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
        "bundles": {
          "type": "array", "maxItems": 16384,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "manifestSha256"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "manifestSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "requires", "assets"],
      "properties": {
        "schema": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "assets": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/asset" } }
      }
    }
  }
}
