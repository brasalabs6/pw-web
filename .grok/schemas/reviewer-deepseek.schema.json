{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PW Web deepseek independent review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer",
    "status",
    "decision",
    "summary",
    "findings",
    "tests_assessed",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "reviewer": {
      "type": "string",
      "const": "deepseek"
    },
    "status": {
      "type": "string",
      "enum": [
        "working",
        "final"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested",
        "pending"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "title",
          "detail",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1100
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1100
          }
        }
      }
    },
    "tests_assessed": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 650
      }
    },
    "residual_risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 650
      }
    }
  }
}
