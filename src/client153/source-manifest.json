  "adaptations": [
    {
      "path": "src/client153/Angelica2/Angelica3D/port/mox.cpp",
      "functions": [
        "A3DFrame::Load(binary)",
        "A3DMesh::Load(binary)",
        "A3DMesh::LoadMeshPropV1/V2",
        "A3DMaterial::Load(binary)",
        "AFile::ReadString(char*)"
      ],
      "changes": [
        "fixed-width little-endian decoding",
        "bounds and finite-value checks",
        "transactional CPU output",
        "file and device operations separated from data loading"
      ]
    },
    {
      "path": "tools/assets/pck153.py",
      "functions": [
        "AFilePackGame::InnerOpen(v0x20002)",
        "AFilePackGame::ReadFile",
        "AFilePackBase::CPackageFile logical PCK/PKX stream"
      ],
      "changes": [
        "read-only Python cooker input",
        "bounded inflate and offsets",
        "CP936 names preserved as raw hex and decoded Unicode",
        "encrypted and unverified package versions rejected"
      ]
    },
    {
      "path": "src/client153/Angelica2/AngelicaCommon/Source/AString.cpp",
      "functions": [
        "AString (original public interface and copy-on-write implementation)"
      ],
      "changes": [
        "standard allocation with matching char[] deletion",
        "portable case conversion and signed 64-bit conversion",
        "bounded printf sizing with independent va_list copies and transactional output",
        "MSVC I64/I32 printf length normalization",
        "unaligned word accesses replaced by byte-safe copying/comparison",
        "locked copy constructor no longer reads uninitialized storage"
      ]
    },
    {
      "path": "src/client153/Angelica2/AngelicaCommon/Source/ATime.cpp",
      "functions": [
        "a_GetTime",
        "a_GetSystemTime"
      ],
      "changes": [
        "platform backend owns steady clock and local calendar",
        "preserve uint32 millisecond wrap and optional calendar output pointers",
        "Windows performance counter and local time operations replaced with actual platform operations",
        "ABaseDef DWORD and LONG retain original 32-bit width on LP64 hosts"
      ]
    },
    {
      "path": "src/client153/Angelica2/AngelicaFile/Source/AFile.cpp",
      "functions": [
        "AFile file lifecycle, strings, lines, seek and flags"
      ],
      "changes": [
        "standard local/VFS file operations replace Windows AFPlatform and filesystem helpers",
        "32-bit little-endian MOXB/MOXT and AString length encoding",
        "bounded reads and explicit truncation failure",
        "copying owning file objects is prohibited",
        "no synchronous network operation or complete package preloading"
      ]
    },
    {
      "path": "src/client153/Angelica2/Angelica3D/Source/A3DMatrix.cpp",
      "functions": [
        "A3DVECTOR3/4",
        "A3DMATRIX3/4",
        "A3DQUATERNION conversions and interpolation"
      ],
      "changes": [
        "restore scalar formulas recorded next to original D3DX calls; no D3DX emulation API",
        "preserve original row-vector layout and anonymous struct union compiler extension",
        "normalize axis before rotation to preserve active D3DX normalized-axis behavior",
        "fix incomplete determinant expansion after regression failure",
        "implement formerly empty Quaternion-to-Euler operation with regression",
        "preserve source SLERP threshold and valid-unit quaternion contract",
        "browser model hierarchy consumes original A3DMATRIX4 multiplication",
        "const input matrix constructor and explicit default assignment for modern compilers"
      ]
    }
  ],
