
#ifndef __GNET_USERLOGIN2_HPP
#define __GNET_USERLOGIN2_HPP

#include "rpcdefs.h"
#include "callid.hxx"
#include "state.hxx"
#include "userlogin2arg"
#include "userlogin2res"

#include "gauthserver.hpp"
#include "kickoutuser.hpp"
namespace GNET
{

class UserLogin2 : public ProxyRpc
{
#define	RPC_BASECLASS	ProxyRpc
	#include "userlogin2"
#undef	RPC_BASECLASS

	void Process(Manager *manager, Manager::Session::ID sid)
	{
		// pw-web: gauthd is the TERMINAL node for this ProxyRpc. Same request
		// bookkeeping and same semantics as the v1 UserLogin Server(), which
		// glinkd bypasses when au_version==1 (keyexchange.hpp sends
		// RPC_USERLOGIN2 instead of RPC_USERLOGIN).
		if (!xid.IsRequest())
			return;
		xid.ClrRequest();
		proxy_manager = manager;
		proxy_sid     = sid;
		proxy_xid     = xid;
		xid.SetRequest();

		UserLogin2Arg arg;
		UserLogin2Res res;
		proxy_data >> arg;

		GAuthServer* ausm=GAuthServer::GetInstance();
		char zoneid;
		{
			Thread::Mutex::Scoped l(ausm->locker_zonemap);
			if (ausm->zonemap.find(sid) == ausm->zonemap.end())
			{
				// v1 Server() returns here and the Rpc framework still sends
				// the untouched result (retcode=-1); a ProxyRpc must send it.
				SetResult(res);
				SendToSponsor();
				return;
			}
			zoneid=ausm->zonemap[sid];
		}

		Thread::RWLock::WRScoped l(ausm->locker_map);
		if (ausm->usermap.find(arg.userid)!=ausm->usermap.end())
		{
			if (arg.blkickuser)
			{
				/*send kickuser to proper delivery server*/
				ausm->Send(ausm->usermap[arg.userid].sid,KickoutUser(arg.userid,ausm->usermap[arg.userid].localsid));
			}
			else
			{
				res.retcode=ERR_MULTILOGIN;
				SetResult(res);
				SendToSponsor();
				return;
			}
		}
		res.retcode=ERR_SUCCESS;
		res.blIsGM=1;
		res.func=0;
		res.funcparm=0;
		res.remain_playtime=2954000;
		res.free_time_left=0;
		res.free_time_end=0;
		// pw-web: mirror the fixed privilege list gauthd's QueryUserPrivilege
		// dev handler grants on the v1 path; with blIsGM!=0 gdeliveryd applies
		// res.auth directly in its userlogin2 PostProcess (ProcessUserPrivilege).
		res.auth.add(0);
		res.auth.add(1);
		res.auth.add(2);
		res.auth.add(3);
		res.auth.add(4);
		res.auth.add(5);
		res.auth.add(6);
		res.auth.add(7);
		res.auth.add(8);
		res.auth.add(9);
		res.auth.add(10);
		res.auth.add(11);
		res.auth.add(100);
		res.auth.add(101);
		res.auth.add(102);
		res.auth.add(103);
		res.auth.add(104);
		res.auth.add(105);
		res.auth.add(200);
		res.auth.add(201);
		res.auth.add(202);
		res.auth.add(203);
		res.auth.add(204);
		res.auth.add(205);
		res.auth.add(206);
		ausm->usermap[arg.userid]=UserInfo(sid,arg.localsid,zoneid);
		DEBUG_PRINT("gauthd::userlogin2: user(id=%d,localsid=%d) login successfully from zone %d\n",arg.userid,arg.localsid,zoneid);
		SetResult(res);
		SendToSponsor();
	}

	bool Delivery(Manager::Session::ID proxy_sid, const OctetsStream& osArg)
	{
		// gauthd is the terminal server for this Rpc: no forward hop exists,
		// so fail the delivery (sponsor receives ERR_DELIVER_SEND). Unreachable
		// while Process() above answers every request.
		SetResult(UserLogin2Res(ERR_DELIVER_SEND));
		SendToSponsor();
		return false;
	}

	void PostProcess(Manager::Session::ID proxy_sid,const OctetsStream& osArg, const OctetsStream& osRes)
	{
		// TODO
	}

	void OnTimeout( )
	{
		// TODO Client Only
	}

};

};
#endif
